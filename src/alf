#!/usr/bin/python3

from OllamaTools.ConnectionOllama import client
from OllamaTools.ListAvailableModel import list_models
from HandleResponse import handleResponse
from CliTools.Cli import inputPrompt, thinkVisual, observationVisual, thoughts, webSearchVisual, compressVisual, outputPrint, printLogo, confirmVisual, write_diff, clear_terminal
from Commands import State, handleCommand
from CliTools.Args import parseArgs
from Memory import findConversation, saveConversation, savePendingPrompt
import Commands.builtin
import os
import sys
import ollama
import httpx
from Variables import tools, available
from AlfTools.Permissions import ALLOWED_DIRS
from AlfTools import RunCommand
from OllamaTools.StreamHandle import EmptyResponseError
from OllamaTools.ModelContext import resolveMaxTokens
from Context import contextLine, formatKTokens, isNearBudget, estimateTokens
from OllamaTools.Summarize import compactIfNeeded
from Variables import COMPACT_RATIO

clear_terminal()

if __name__=="__main__":
    args = parseArgs()
    if args.allowed_dir:
        missing = [d for d in args.allowed_dir if not os.path.isdir(d)]
        if missing:
            sys.exit(f"Allowed directory not found: `{missing[0]}`")
        ALLOWED_DIRS[:] = [os.path.realpath(d) for d in args.allowed_dir]
    if args.no_sandbox:
        RunCommand.SANDBOX = False
    printLogo()
    if args.no_sandbox:
        outputPrint("Warning: --no-sandbox: commands run directly on this machine, this can cause security problems.")
    try:
        modelNames = list_models(client)[0]
    except (ConnectionError, httpx.HTTPError) as e:
        sys.exit(f"Cannot reach Ollama: {e}")
    model = "gemma4:e2b-mt"
    fixed = args.max_tokens is not None
    state = State(model=model, modelNames=modelNames, maxTokens=args.max_tokens if fixed else resolveMaxTokens(client, model), maxTokensFixed=fixed, mode="auto" if args.auto else "ask")
    if args.think:
        outputPrint(handleCommand("/think on", state))
    reference = "1" if args.continue_ else args.resume
    if reference is not None:
        conversation = findConversation(reference)
        if conversation is None:
            sys.exit(f"No conversation found for `{reference}`. Type `/conversations` in ALF-CLI to list them.")
        state.resume(conversation)
        outputPrint(f"Conversation resumed: `{conversation['title']}` ({len(state.history)} messages)")
        print('\033[90m' + contextLine(None, state.maxTokens, state.contextMessages(), total=state.totalTokens, hidden=state.conversation['summarizedCount']) + '\033[0m')
    while state.running:
        prompt = inputPrompt()
        message = handleCommand(prompt, state)
        if message is not None:
            if message:
                outputPrint(message)
            continue
        if not prompt.strip():
            lines = prompt.split('\n')
            nlines = len(lines) + 3
            sys.stdout.write('\x1b[%sA' % (nlines - 1))
            sys.stdout.write('\r')
            continue
        promptTokens = estimateTokens([{"role": "user", "content": prompt}])
        if promptTokens > COMPACT_RATIO * state.maxTokens:
            outputPrint(f"This message is too long for the context ({formatKTokens(promptTokens)}/{formatKTokens(state.maxTokens)}). Shorten it or raise --max-tokens.")
            continue
        compactIfNeeded(client, state.model, state.conversation, state.history, prompt, state.maxTokens, outputPrint, compressVisual)
        savePendingPrompt(state.conversation, state.history, prompt)
        historySize = len(state.history)
        thoughts.clear()
        try:
            response_history, token_used, generated = handleResponse(
                client=client,
                model=state.model,
                prompt=prompt,
                history=state.history,
                tools=tools,
                available=available,
                printfunc=outputPrint,
                difffunc=write_diff,
                validationfunc=confirmVisual,
                visualfuncs={"think": thinkVisual, "websearch": webSearchVisual, "observation": observationVisual},
                think=state.think,
                max_tokens=state.maxTokens,
                summary=state.conversation["summary"],
                summarizedCount=state.conversation["summarizedCount"],
                auto=state.mode == "auto",
            )
        except (ollama.ResponseError, ConnectionError, httpx.HTTPError) as e:
            del state.history[historySize:]
            outputPrint(f"Ollama error, the conversation is unchanged: {e}")
            continue
        except EmptyResponseError as e:
            del state.history[historySize:]
            outputPrint(f"{e} The conversation is unchanged.")
            continue
        state.contextUsed = token_used
        state.totalTokens += generated or 0
        state.history = response_history
        state.conversation["totalTokens"] = state.totalTokens
        saveConversation(state.conversation, state.history)
        context = state.contextMessages()
        print()
        print('\033[90m' + contextLine(state.contextUsed, state.maxTokens, context, generated, state.totalTokens, state.conversation['summarizedCount']) + '\033[0m')
        used = state.contextUsed if state.contextUsed is not None else estimateTokens(context)
        if isNearBudget(used, state.maxTokens):
            outputPrint(f"Warning: the context is over 80% of the budget ({formatKTokens(state.maxTokens)}). Use `/new` or raise `--max-tokens`.")
    ollama.generate(model=state.model, keep_alive=0)
