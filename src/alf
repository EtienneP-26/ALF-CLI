#!/usr/bin/python3

from OllamaTools.ConnectionOllama import client
from OllamaTools.ListAvailableModel import list_models
from HandleResponse import handleResponse
from CliTools.Cli import inputPrompt, thinkVisual, webSearchVisual, outputPrint, printLogo, confirmVisual, write_diff
from Commands import State, handleCommand
from CliTools.Args import parseArgs
from Memory import findConversation, saveConversation
import Commands.builtin
import os
import sys
import ollama
from Variables import tools, available

def clear_terminal():
     os.system('cls' if os.name == 'nt' else 'clear')

clear_terminal()

if __name__=="__main__":
    args = parseArgs()
    printLogo()
    state = State(model="gemma4:e2b-mt", modelNames=list_models(client)[0])
    reference = "1" if args.continue_ else args.resume
    if reference is not None:
        conversation = findConversation(reference)
        if conversation is None:
            sys.exit(f"No conversation found for `{reference}`. Type `/conversations` in ALF-CLI to list them.")
        state.resume(conversation)
        outputPrint(f"Conversation resumed: `{conversation['title']}` ({len(state.history)} messages)")
    total_token_used: int = 0
    while state.running:
        prompt = inputPrompt()
        message = handleCommand(prompt, state)
        if message is not None:
            if message:
                outputPrint(message)
            continue
        if not prompt.strip():
            lines = prompt.split('\n')
            nlines = len(lines) + 3
            sys.stdout.write('\x1b[%sA' % (nlines - 1))
            sys.stdout.write('\r')
            continue
        response_history, token_used, = handleResponse(
                client=client,
                model=state.model,
                prompt=prompt,
                history=state.history,
                tools=tools,
                available=available,
                printfunc=outputPrint,
                difffunc=write_diff,
                validationfunc=confirmVisual,
                visualfuncs={"think": thinkVisual, "websearch": webSearchVisual},
                think=False,
        )
        state.history = response_history
        saveConversation(state.conversation, state.history)
        print()
        total_token_used += token_used
        print('\033[90m' + f"Message: {token_used} Tokens | Total: {total_token_used} Tokens" + '\033[0m')
    ollama.generate(model=state.model, keep_alive=0)
